# Copie este arquivo para .env e ajuste os valores antes de rodar scripts\iniciar.ps1
# Baseado no .env.example oficial de h-mdm/hmdm-docker, adaptado para piloto local (HTTP).

# --- Banco de dados ---
SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=TrocarEstaSenhaForte123!

# --- Administrador ---
ADMIN_EMAIL=seuemail@empresa.com.br

# --- Endereço do servidor ---
# Em piloto local, use o IP do seu PC na rede Wi-Fi/LAN (não "localhost" — os
# celulares precisam alcançar esse endereço). Descubra com: ipconfig
# (campo "Endereço IPv4" do adaptador Wi-Fi ou Ethernet). Exemplo: 192.168.1.50
BASE_DOMAIN=192.168.1.50
LOCAL_IP=192.168.1.50

# Ligue este parâmetro (true) sempre que mudar variáveis acima e reiniciar;
# depois de subir com sucesso, volte para vazio.
FORCE_RECONFIGURE=

# Piloto local = http. Em produção (VPS com domínio público), use https.
PROTOCOL=http

# Troque também este valor (usado por plugins/premium; mantenha único mesmo no piloto)
SHARED_SECRET=troque-este-valor-tambem-987xyz

# --- Versão do Headwind MDM a instalar ---
HMDM_VARIANT=os
DOWNLOAD_CREDENTIALS=
HMDM_URL=https://h-mdm.com/files/hmdm-5.40.1-os.war
CLIENT_VERSION=6.37

# --- Troca de política por horário (scripts\alternar-politica.ps1) ---
# Usuário do painel usado pela automação (crie um usuário próprio em Users, não use o admin).
MDM_API_URL=http://192.168.1.50:8080
MDM_API_USER=admin
MDM_API_PASS=TROCAR
# Nome do grupo cujos aparelhos serão trocados e nomes EXATOS das duas Configurations.
MDM_GRUPO=Vendedor Externo
MDM_CFG_EXPEDIENTE=Vendedores Externos - Padrão
MDM_CFG_FORA_EXPEDIENTE=Vendedores Externos - Fora de Expediente
# Janela em que o app de trabalho fica visível (modo -Politica Auto)
MDM_HORA_INICIO=08:00
MDM_HORA_FIM=22:00

# --- Mapa do portal ---
# Chave da "Maps JavaScript API" do Google. Vazio = usa OpenStreetMap.
# A chave fica visível no navegador: restrinja por endereço e por API no Google Cloud.
GOOGLE_MAPS_API_KEY=
